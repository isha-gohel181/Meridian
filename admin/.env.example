# Meridian Group of Education — Admin Application Environment Template
# For local dev, copy to `.env` or rely on `.env.development` (Vite loads it automatically).
VITE_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
VITE_BASE_URL_ADMIN=http://localhost:5000
VITE_IMAGE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_SOCKET_PATH=/socket.io
VITE_SUPPORT_EMAIL=info@meridiangroupofeducation.in
# VITE_GOOGLE_CLIENT_ID=

